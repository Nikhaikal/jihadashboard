rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function manager() { return request.auth != null && request.auth.token.email in ['nikkhaikal@gmail.com','nealia.najihah@gmail.com']; }
    match /dashboards/main { allow read: if request.auth != null; allow create, update: if manager(); }
    match /hps/{code} { allow read: if request.auth != null; allow update: if manager() || (request.auth != null && (resource.data.uid == request.auth.uid || resource.data.get('parentUid', null) == request.auth.uid) && request.resource.data.uid == resource.data.uid && request.resource.data.get('parentUid', null) == resource.data.get('parentUid', null) && request.resource.data.name == resource.data.name && request.resource.data.email == resource.data.email && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt); }
    match /users/{userId} { allow read: if request.auth != null && (manager() || request.auth.uid == userId); allow write: if false; }
  }
}
